{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://peter-spiegel.com/schema/behavioral-requirement.json",
  "title": "Behavioral Requirement (Contract Story)",
  "type": "object",
  "required": ["id", "story", "verhalten", "akzeptanz"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^STORY-[0-9]{3,}$" },
    "story": { "type": "string", "description": "Als <Rolle> will ich <Ziel>, damit <Nutzen>." },
    "evidenz": { "type": "array", "items": { "type": "string" }, "description": "IDs aus dem Evidenzregister, z. B. I-3, R-4" },
    "dimension": {
      "type": "string",
      "enum": ["Aufgabenangemessenheit","Selbstbeschreibung","Erwartungskonformitaet","Steuerbarkeit","Fehlertoleranz","Lernfoerderlichkeit","Individualisierbarkeit","Zugaenglichkeit","Joy of Use"],
      "description": "Qualitaetsdimension nach ISO 9241-110 (+ Zugaenglichkeit, Joy of Use)"
    },
    "verhalten": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Das Wie, in EARS-Form: 'Wenn ..., soll das System ...'" },
    "zustaende": { "type": "array", "items": { "type": "string" } },
    "nicht_funktional": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "a11y, datenschutz, performance ..."
    },
    "akzeptanz": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "BDD/Gherkin — Given/When/Then/And" },
    "ui": { "type": "array", "items": { "type": "string" }, "description": "Bezug zum UI Contract: Komponenten und Tokens" },
    "status": { "type": "string", "enum": ["draft","review","approved","deprecated"] },
    "sicherheit": { "type": "string", "enum": ["niedrig","mittel","hoch"] }
  }
}
